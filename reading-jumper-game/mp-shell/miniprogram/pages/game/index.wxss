page,
web-view {
  width: 100%;
  height: 100%;
  background: #5bb8f5;
}

.fallback {
  display: flex;
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  color: #fff;
  background: #5bb8f5;
}

.fallback__title {
  font-size: 30rpx;
}

.fallback__button {
  margin: 0;
  padding: 0 40rpx;
  color: #fff;
  background: #16825d;
  font-size: 28rpx;
}

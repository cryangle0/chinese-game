page {
  background: linear-gradient(135deg, #fff8d9 0%, #ffe0a0 56%, #f4bd68 100%);
}

.share {
  display: flex;
  width: 100%;
  height: 100%;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #fff8d9 0%, #ffe0a0 56%, #f4bd68 100%);
}

.share__card {
  display: flex;
  width: 620rpx;
  padding: 40rpx 48rpx;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  border-radius: 28rpx;
  background: #fffaf0;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.35);
}

.share__title {
  color: #5a3210;
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
}

.share__hint {
  color: #9a7b5a;
  font-size: 24rpx;
}

.share__actions {
  display: flex;
  width: 100%;
  margin-top: 12rpx;
  gap: 20rpx;
}

.share__button {
  flex: 1;
  margin: 0;
  color: #5a3210;
  background: #f0e2c8;
  font-size: 28rpx;
}

.share__button--primary {
  color: #fff;
  background: #16825d;
}
